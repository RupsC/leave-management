# Copy this file to .env and fill in your own values.
# Never commit the real .env file - it is ignored by git.

# Port the web server listens on
PORT=3000

# Where the SQLite database file is stored (created automatically)
DB_PATH=./data/leave.db

# Where uploaded supporting documents are stored.
# Must stay OUTSIDE the public/ web root.
UPLOAD_DIR=./storage/uploads

# How long a signed-in session lasts, in hours
SESSION_TTL_HOURS=12

# Maximum size of an uploaded document, in megabytes
MAX_UPLOAD_MB=2

# Secret used to sign the session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Set to "production" when running on a real server (enables secure cookies)
NODE_ENV=development
